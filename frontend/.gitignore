# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Ngoại lệ: file MẪU không chứa giá trị bí mật nào, cần đưa lên Git để
# người khác (hoặc chính mình lúc dựng lại máy) biết cần khai báo
# những biến nào.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
