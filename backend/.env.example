# Đây là file MẪU - copy thành ".env" (bỏ chữ .example) rồi điền giá trị thật.
# File ".env" thật KHÔNG được đưa lên Git (đã khai báo trong .gitignore).

# Chuỗi kết nối Postgres - lấy từ Neon dashboard.
# Ví dụ định dạng: postgresql+asyncpg://myuser:mypass@ep-xxx.neon.tech/academic_assistant
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/academic_assistant

# API key OpenAI - lấy tại https://platform.openai.com/api-keys
# BẮT BUỘC điền giá trị thật - server sẽ từ chối khởi động nếu để trống.
OPENAI_API_KEY=sk-...

# Chuỗi bí mật để ký JWT - BẮT BUỘC điền giá trị ngẫu nhiên thật, sinh
# bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Server sẽ TỪ CHỐI KHỞI ĐỘNG nếu biến này bị để trống - đây là chủ ý,
# không phải lỗi: một JWT_SECRET rỗng vẫn "ký" được token bình thường
# về mặt kỹ thuật, nhưng "bí mật" đó lúc này là công khai (ai cũng biết
# nó là chuỗi rỗng), nên ai cũng tự ký được JWT giả mạo bất kỳ quyền
# nào - thà server không chạy còn hơn chạy mà mất an toàn âm thầm.
JWT_SECRET=

# Thuật toán ký JWT - để mặc định HS256, không cần đổi trừ khi có lý do rõ ràng
JWT_ALGORITHM=HS256

# ACCESS token (JWT dùng cho mọi request) sống bao nhiêu phút - mặc
# định 30. Access token không thể thu hồi giữa chừng, phải sống ngắn
# để giới hạn thiệt hại nếu bị lộ. Phiên đăng nhập được "nối dài" qua
# REFRESH token bên dưới.
JWT_EXPIRE_MINUTES=30

# REFRESH token sống bao nhiêu ngày - mặc định 7. Khác access token,
# refresh token CÓ THỂ thu hồi ngay lập tức (lưu trong DB).
REFRESH_TOKEN_EXPIRE_DAYS=7

# Danh sách domain ĐƯỢC PHÉP gọi API này từ trình duyệt (CORS), phân
# tách bằng dấu phẩy. Lúc dev chỉ cần localhost:3000 (nơi Next.js sẽ
# chạy); khi deploy thật, thêm domain frontend thật vào, ví dụ:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://academic-assistant.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
