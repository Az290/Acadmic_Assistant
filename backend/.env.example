# MẪU cấu hình - sao chép thành ".env" rồi điền giá trị THẬT.
# File .env KHÔNG BAO GIỜ được đưa lên Git (đã chặn trong .gitignore).
#
# Trên máy chủ Fly.io, KHÔNG dùng file này - đặt từng giá trị bằng lệnh:
#   fly secrets set DATABASE_URL="..." OPENAI_API_KEY="..." JWT_SECRET="..."

# Chuỗi kết nối Neon Postgres. Lưu ý 2 điểm khi sao chép từ Neon:
# 1. Đổi tiền tố "postgresql://" thành "postgresql+asyncpg://"
# 2. XOÁ tham số "?sslmode=require" ở cuối (asyncpg không hiểu tham số
#    này của thư viện khác; nó vốn đã dùng SSL sẵn với Neon)
DATABASE_URL=postgresql+asyncpg://user:password@host.neon.tech/dbname

# API key OpenAI - dùng cho cả sinh câu trả lời lẫn tìm kiếm ngữ nghĩa
OPENAI_API_KEY=sk-...
NOVA_EVIDENCE_PLANNER_ENABLED=true
NOVA_EVIDENCE_PLANNER_MODEL=gpt-4o-mini
NOVA_EVIDENCE_PLANNER_TIMEOUT_SECONDS=12
NOVA_MULTI_QUERY_ENABLED=false
NOVA_QUERY_GENERATOR_MODEL=gpt-4o-mini
NOVA_QUERY_GENERATOR_TIMEOUT_SECONDS=10
NOVA_MAX_SEARCH_QUERIES=3
NOVA_RETRIEVAL_CANDIDATE_LIMIT=20
NOVA_RERANKER_ENABLED=false
NOVA_RERANKER_MODEL=gpt-4o-mini
NOVA_RERANKER_TIMEOUT_SECONDS=12
NOVA_RESPONSE_COMPOSER_ENABLED=true

# Chuỗi ngẫu nhiên dùng để ký vé đăng nhập. Sinh bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Máy chủ SẼ KHÔNG KHỞI ĐỘNG nếu để trống (có kiểm tra trong config.py).
JWT_SECRET=

# Các domain được phép gọi API từ trình duyệt, cách nhau bằng dấu phẩy.
# Production: thêm domain thật của frontend, ví dụ:
#   CORS_ALLOWED_ORIGINS=https://academic-assistant.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# "lax" khi chạy ở máy cá nhân; BẮT BUỘC đổi thành "none" nếu frontend
# và backend nằm ở 2 domain khác nhau (Vercel + Fly.io) - nếu không,
# trình duyệt sẽ không gửi cookie và người dùng không thể đăng nhập.
# Xem giải thích đầy đủ trong app/config.py.
COOKIE_SAMESITE=lax
COOKIE_SECURE=true
# Secret HMAC rieng cho Discord/Zalo/Messenger webhook (Phase 6+)
CONNECTOR_WEBHOOK_SECRET=
DISCORD_CONNECTOR_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_BOT_USER_ID=
DISCORD_INTERNAL_API_BASE=http://127.0.0.1:8001
ZALO_CONNECTOR_ENABLED=false
ZALO_GMF_ENABLED=false
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
ZALO_INTERNAL_API_BASE=http://127.0.0.1:8001
ZALO_CALLBACK_SECRET=
CONNECTOR_EVENT_RETENTION_DAYS=7
CONNECTOR_PROCESSING_TIMEOUT_SECONDS=300
NOVA_ROLLOUT_PERCENT=100
NOVA_ROLLBACK_DEAD_JOBS_THRESHOLD=5
NOVA_ROLLBACK_P95_LATENCY_MS=20000
PUBLIC_WEB_URL=http://localhost:3000
