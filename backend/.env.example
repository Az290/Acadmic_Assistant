# Đây là file MẪU - copy thành ".env" (bỏ chữ .example) rồi điền giá trị thật.
# File ".env" thật KHÔNG được đưa lên Git (đã khai báo trong .gitignore).

# Chuỗi kết nối Postgres - sẽ lấy từ Neon dashboard khi tạo tài khoản (Tác vụ deploy).
# Ví dụ định dạng: postgresql+asyncpg://myuser:mypass@ep-xxx.neon.tech/academic_assistant
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/academic_assistant

# API key OpenAI - lấy tại https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Chuỗi bí mật để ký JWT (Tác vụ #3 - Auth) - BẮT BUỘC điền giá trị
# ngẫu nhiên thật, sinh bằng lệnh:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Thuật toán ký JWT - để mặc định HS256, không cần đổi trừ khi có lý do rõ ràng
JWT_ALGORITHM=HS256

# ACCESS token (JWT dùng cho mọi request) sống bao nhiêu phút - mặc
# định 30. KHÔNG nên để dài như trước đây (Tác vụ #4.5): access token
# không thể thu hồi giữa chừng, phải sống ngắn để giới hạn thiệt hại
# nếu bị lộ. Phiên đăng nhập được "nối dài" qua REFRESH token bên dưới.
JWT_EXPIRE_MINUTES=30

# REFRESH token (Tác vụ #4.5) sống bao nhiêu ngày - mặc định 7. Khác
# access token, refresh token CÓ THỂ thu hồi ngay lập tức (lưu trong DB).
REFRESH_TOKEN_EXPIRE_DAYS=7

# Danh sách domain ĐƯỢC PHÉP gọi API này từ trình duyệt (CORS, Tác vụ
# #4.5), phân tách bằng dấu phẩy. Lúc dev chỉ cần localhost:3000 (nơi
# Next.js sẽ chạy); khi deploy thật, thêm domain Vercel vào, ví dụ:
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,https://academic-assistant.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000
